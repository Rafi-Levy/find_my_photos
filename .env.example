# =============================================================================
# WhatsApp Kid-Photo Auto-Forwarder — Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Run `npm run list-chats` to find your chat IDs.
# =============================================================================

# The WhatsApp group to watch for incoming media
# Must be a group ID ending in @g.us
SOURCE_CHAT_ID=xxxxxxxxxx@g.us

# Where matched media gets forwarded — can be either:
#   a group:   ...@g.us
#   a person:  ...@c.us  (e.g. straight to a co-parent)
TARGET_CHAT_ID=yyyyyyyyyy@g.us

# Face recognition threshold (euclidean distance)
# Lower = stricter (fewer false positives, more missed matches)
# Higher = more lenient (catches more, but may false-match)
# Recommended range: 0.45 – 0.6
# Default 0.5 is fairly strict; increase to 0.55–0.6 if missing matches
MATCH_THRESHOLD=0.5

# Number of evenly-spaced frames to extract from videos for face checking
VIDEO_FRAMES_TO_CHECK=5

# =============================================================================
# SAFETY CONTROLS (Zero Unintended Messages Guarantee)
# =============================================================================

# Dry-Run / Safe Mode:
# Default is false.
# When false, the forwarder is in SAFE DRY-RUN mode:
#   - It monitors, detects, and matches faces normally.
#   - ZERO messages are sent to WhatsApp.
#   - Matching media is saved to MATCH_PREVIEW_PATH for visual verification.
# Set to 'true' ONLY when you are 100% confident in the match accuracy and ready for live forwarding!
ENABLE_FORWARDING=false

# Group Target Protection:
# Set to 'true' ONLY if TARGET_CHAT_ID is deliberately a group (@g.us).
# If false, the forwarder refuses to send to any group, ensuring messages
# can only go to an individual 1:1 contact (@c.us, e.g. co-parent).
ALLOW_GROUP_FORWARDING=false

# --- Paths (relative to project root) ---

# Where matched media is saved for review (always saved, even in dry-run mode)
MATCH_PREVIEW_PATH=./matches_preview

# Where reference photos of your child are placed for training/enrollment
TRAIN_PHOTOS_PATH=./train_photos

# Where the averaged face embedding is stored (created by `npm run enroll`)
REFERENCE_EMBEDDING_PATH=./data/child-reference.json

# WhatsApp session data directory (created automatically on first login)
SESSION_DATA_PATH=./.wwebjs_auth

# Activity log file
LOG_PATH=./logs/activity.log

# Face-api.js model weights directory (populated by `npm run download-models`)
MODELS_PATH=./models

# =============================================================================
# NIGHTLY AUTO-RESTART (Memory Maintenance)
# =============================================================================
# Automatically restarts every night at 00:00 UTC to reclaim Chromium RAM
# and refresh the WhatsApp Web session.
AUTO_RESTART_ENABLED=true
AUTO_RESTART_TIME_UTC=00:00
# Restart mode:
#   'in-process' (default) -> Re-initializes Chromium/WhatsApp inside current terminal without closing
#   'exit'                 -> Exits with code 42 (recommended when using start.bat, PM2, or Docker)
AUTO_RESTART_MODE=in-process

