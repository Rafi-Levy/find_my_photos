{
  "name": "whatsapp-kid-forwarder",
  "version": "1.0.0",
  "description": "Local WhatsApp media forwarder with face recognition — watches a group, detects your child's face, forwards matching photos/videos.",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "cli": "node index.js",
    "ui": "node server.js",
    "setup": "node scripts/setup.js",
    "doctor": "node scripts/doctor.js",
    "enroll": "node enroll.js",
    "test-match": "node scripts/test-match.js",
    "matches": "node scripts/matches.js",
    "list-chats": "node list-chats.js",
    "search-chats": "node search-chats.js",
    "download-models": "node download-models.js",
    "test": "node test-safety.js",
    "test-safety": "node test-safety.js",
    "postinstall": "node scripts/patch-wwebjs.js && node download-models.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^1.4.2",
    "@tensorflow/tfjs": "^4.22.0",
    "@vladmandic/face-api": "^1.7.14",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^2.3.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.33.5",
    "whatsapp-web.js": "^1.26.1-alpha.3"
  }
}
